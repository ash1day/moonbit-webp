///|
/// Neighbour samples shared by the predictor tests: the same pattern the C
/// harness used when running libwebp's predictors.
fn predictor_test_buffer() -> FixedArray[Int32] {
  FixedArray::makei(bps * 20, fn(i) { (i * 73 + 11) % 251 })
}

///|
fn predicted_block(buf : FixedArray[Int32], size : Int32) -> Array[Int32] {
  let got = []
  for y in 0..<size {
    for x in 0..<size {
      got.push(buf[bps + 8 + x + y * bps])
    }
  }
  got
}

///|
/// Expected values are from libwebp's 4x4 predictors (DC4_C ... HU4_C).
test "4x4 intra predictors match libwebp" {
  let expected : Array[Array[Int32]] = [
    [
      113, 113, 113, 113, 113, 113, 113, 113, 113, 113, 113, 113, 113, 113, 113,
      113,
    ],
    [
      170, 243, 255, 138, 247, 255, 255, 215, 73, 146, 219, 41, 150, 223, 255, 118,
    ],
    [93, 166, 176, 124, 93, 166, 176, 124, 93, 166, 176, 124, 93, 166, 176, 124],
    [97, 97, 97, 97, 111, 111, 111, 111, 63, 63, 63, 63, 58, 58, 58, 58],
    [58, 93, 166, 176, 97, 58, 93, 166, 111, 97, 58, 93, 63, 111, 97, 58],
    [57, 130, 203, 150, 58, 93, 166, 176, 97, 57, 130, 203, 111, 58, 93, 166],
    [
      166, 176, 124, 134, 176, 124, 134, 144, 124, 134, 144, 92, 134, 144, 92, 84,
    ],
    [
      130, 203, 150, 98, 166, 176, 124, 134, 203, 150, 98, 144, 176, 124, 134, 92,
    ],
    [59, 58, 93, 166, 136, 97, 59, 58, 87, 111, 136, 97, 39, 63, 87, 111],
    [136, 111, 87, 63, 87, 63, 39, 58, 39, 58, 77, 77, 77, 77, 77, 77],
  ]
  for mode in 0..<10 {
    let buf = predictor_test_buffer()
    predict_luma4(mode, buf, bps + 8)
    assert_eq((mode, predicted_block(buf, 4)), (mode, expected[mode]))
  }
}

