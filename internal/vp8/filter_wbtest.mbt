///|
fn check_filter(
  input : FixedArray[Int32],
  name : String,
  run : (FixedArray[Byte], Int32, Int32) -> Unit,
  changes : Array[Int32],
) -> Unit raise {
  let buf = FixedArray::makei(input.length(), fn(i) { input[i].to_byte() })
  run(buf, 8 * 40 + 8, 40)
  let expected = input.copy()
  for i = 0; i < changes.length(); i = i + 2 {
    expected[changes[i]] = changes[i + 1]
  }
  for i in 0..<buf.length() {
    if buf[i].to_int() != expected[i] {
      fail("\{name}: index \{i} is \{buf[i].to_int()}, expected \{expected[i]}")
    }
  }
}

///|
test "loop filters match libwebp on a noisy block" {
  check_filter(
    filter_input0,
    "sv",
    fn(buf, p, w) { simple_v_filter16(buf, p, w, 20) },
    [],
  )
  check_filter(
    filter_input0,
    "sh",
    fn(buf, p, w) { simple_h_filter16(buf, p, w, 20) },
    [727, 26, 728, 21],
  )
  check_filter(
    filter_input0,
    "svi",
    fn(buf, p, w) { simple_v_filter16i(buf, p, w, 20) },
    [459, 54, 499, 51],
  )
  check_filter(
    filter_input0,
    "shi",
    fn(buf, p, w) { simple_h_filter16i(buf, p, w, 20) },
    [539, 72, 540, 66],
  )
  check_filter(
    filter_input0,
    "v",
    fn(buf, p, w) { v_filter16(buf, p, w, 30, 6, 1) },
    [],
  )
  check_filter(
    filter_input0,
    "h",
    fn(buf, p, w) { h_filter16(buf, p, w, 30, 6, 1) },
    [],
  )
  check_filter(
    filter_input0,
    "vi",
    fn(buf, p, w) { v_filter16i(buf, p, w, 30, 6, 1) },
    [],
  )
  check_filter(
    filter_input0,
    "hi",
    fn(buf, p, w) { h_filter16i(buf, p, w, 30, 6, 1) },
    [],
  )
  check_filter(
    filter_input0,
    "v8",
    fn(buf, p, w) {
      v_filter8(buf, p, w, 30, 6, 2)
      v_filter8(buf, p + 16, w, 30, 6, 2)
    },
    [],
  )
  check_filter(
    filter_input0,
    "h8",
    fn(buf, p, w) {
      h_filter8(buf, p, w, 30, 6, 2)
      h_filter8(buf, p + 16, w, 30, 6, 2)
    },
    [],
  )
  check_filter(
    filter_input0,
    "v8i",
    fn(buf, p, w) {
      v_filter8i(buf, p, w, 30, 6, 2)
      v_filter8i(buf, p + 16, w, 30, 6, 2)
    },
    [],
  )
  check_filter(
    filter_input0,
    "h8i",
